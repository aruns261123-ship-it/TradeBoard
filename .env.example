[TEMPLATE]
# --- Database ---
# Local dev (docker compose up -d): postgres://tradeboard:tradeboard@localhost:5432/tradeboard
# Neon: postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgres://tradeboard:tradeboard@localhost:5432/tradeboard"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
# Public URL of the site (used in emails and absolute links).
# Production: full URL WITH https:// (e.g. "https://tradeboard.vercel.app"). Never set it empty —
# if you don't have the final domain yet, omit the variable on Vercel and the app falls back
# to VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe ---
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs from Stripe dashboard (or leave empty to use dev-mode mock checkout)
STRIPE_PRICE_STANDARD="price_..."
STRIPE_PRICE_FEATURED="price_..."
STRIPE_PRICE_PACK5="price_..."
STRIPE_PRICE_AGENCY="price_..."

# --- Email (Resend, free tier: 100/day) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="TradeBoard <jobs@yourdomain.com>"
# Contact form submissions go here
CONTACT_EMAIL="you@yourdomain.com"

# --- Admin bootstrap (seed script creates this account) ---
ADMIN_EMAIL="admin@localhost"
ADMIN_PASSWORD="admin1234"

# --- Cron protection (set a random string; cron calls send ?key=) ---
CRON_SECRET="change-me"
